# ======================================
# إعدادات مشروع المساعد المدرسي الذكي
# ======================================

# مفتاح Django السري (يجب تغييره في بيئة الإنتاج)
SECRET_KEY=your-secret-key-here

# وضع التطوير (True للتطوير، False للإنتاج)
DEBUG=True

# المضيفات المسموح بها (مفصولة بفواصل)
ALLOWED_HOSTS=localhost,127.0.0.1

# إعدادات CORS
CORS_ALLOW_ALL_ORIGINS=True
